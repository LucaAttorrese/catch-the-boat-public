# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs & artifacts
*.log
logs/
runs/
results/
*.mp4
*.gif
# Debug PNG dumps written to repo root by scripts/debug_*.py
first_frame.png
render_alt_*.png

# Generated assets (regenerable via scripts/generate_aruco.py)
boat_landing/assets/aruco/*.png

# Local configs
.local/
*.local.yaml

# Private evaluation scenarios — organizer-only, must NEVER ship to
# participants. The directory itself is kept (.gitkeep) so the tree
# structure is visible, but content (.yaml) is ignored. README.md is
# tracked explicitly so the next organizer knows the rules.
scenarios/private/*.yaml
!scenarios/private/.gitkeep
!scenarios/private/README.md

# Compiled reference simulator artefacts — never ship the .pyx/.c
# intermediate files, only the final .so/.pyd in the participant wheel.
boat_landing/reference_sim/_core.c
boat_landing/reference_sim/build/
# Reference sim binary staged at container start by the :full image's
# entrypoint (release/docker-entrypoint-full.sh). On Linux/Mac hosts
# this file appears in the workspace mount as a regular file owned by
# the host user; on Windows it lives on the host FS via WSL/virtiofs.
# Either way it must not be committed — the binary ships through the
# Docker image, not through the repo.
boat_landing/reference_sim/_core.cpython-*.so
boat_landing/reference_sim/_core*.pyd

# Claude Code local settings — personal/per-machine, never share.
.claude/

# Scratch build/eval output directory used during dev.
build/

